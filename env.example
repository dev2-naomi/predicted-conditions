# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Required ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional ---
# Override the default Anthropic model (default: claude-opus-4-5)
ANTHROPIC_MODEL=claude-opus-4-5

# Fallback chain used only when the primary model is overloaded/rate-limited.
# Tier 1 (same provider): Anthropic Sonnet. Set to "" to disable this tier.
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-5
#
# Tier 2 (cross-provider): OpenAI reasoning model — most effective during an
# Anthropic-wide overload. Enabled automatically when OPENAI_API_KEY is set.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_FALLBACK_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=medium   # low|medium|high; "" disables reasoning

# Overload/rate-limit retry tuning (exponential backoff with jitter).
# LLM_MAX_RETRIES=8
# LLM_RETRY_COOLDOWN=5
# LLM_RETRY_MAX_BACKOFF=60

# LangSmith tracing (optional but recommended for observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=predicted-conditions

# --- Dev mode overrides ---
# DEV_MODE_ENABLED=true
# DEV_MODE_SKIP_STEPS=STEP_02,STEP_03
# DEV_MODE_CUTOFF_STEP=STEP_04

# --- AWS deployment (see docs/AWS_DEPLOYMENT.md) ---
# Only needed for `infra/deploy.sh` / `infra/sync_github_secrets.sh` / local
# testing against the deployed Lambda. Not read by agent.py itself.

# Credentials used by `cdk deploy` and the AWS CLI (skip if using
# `aws configure` / `aws sso login` / an assumed role instead).
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-2

# Shared secret for the deployed API's `x-api-key` header (infra/deploy.sh
# pushes this to Secrets Manager; api/main.py's api_key_middleware checks
# it). Generate any random string, e.g. `openssl rand -hex 32`.
# API_KEY is dev's key. Dedicate a *different* random value to prod as
# API_KEY_PROD — infra/deploy.sh uses API_KEY_PROD instead of API_KEY when
# deploying the prod stage, so `./infra/deploy.sh prod` never overwrites
# prod's key back to dev's. Keep them different so a leaked/rotated dev key
# can't be used against prod, and vice versa.
API_KEY=your_own_api_key_for_the_deployed_dev_endpoint
API_KEY_PROD=your_own_api_key_for_the_deployed_prod_endpoint

# Point test_cloud.py / run_manifest_cloud.py / etc. at the deployed Lambda
# instead of LangGraph Platform Cloud. These scripts send `API_KEY` (falling
# back to LANGCHAIN_API_KEY only if API_KEY is unset) as the x-api-key
# header, so just set LANGGRAPH_URL after `infra/deploy.sh dev`:
# LANGGRAPH_URL=https://xxxxxxxx.lambda-url.us-east-2.on.aws

# Non-secret CORS config for the FastAPI shim (local dev only — the deployed
# Lambda Function URL sets its own CORS headers).
# CORS_ALLOW_ORIGINS=*

# Run the FastAPI shim locally without AWS (`uvicorn api.main:app --reload`)
# by using an in-memory checkpointer/thread-store instead of DynamoDB.
# CHECKPOINT_IN_MEMORY=true
